# ============================================================
# AI 智能运维助手 — 环境变量配置
# ============================================================

# ========== LLM 多模型配置 (SiliconFlow 统一供应商) ==========
# API 密钥（必填，从 https://cloud.siliconflow.cn/ 获取）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
# API 基础地址
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 文本推理模型（主 Agent / Tool Calling / RAG 生成）
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 视觉模型（运维截图分析 / Grafana 面板 / K8s Dashboard OCR）
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ---------- 旧版 LLM 配置（向后兼容） ----------
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-chat

# ---------- 应用配置 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
# Demo 模式（无需真实服务器，模拟所有运维数据）
# DEMO_MODE=true

# ---------- 安全配置 ----------
# JWT 密钥（不要填写真实生产密钥）
# 开发环境可使用占位符；生产环境必须：
#   1) ENVIRONMENT=production
#   2) JWT_SECRET 长度 >= 32
#   3) 不得包含 change-me / secret / password / test
# 生成：openssl rand -hex 32
JWT_SECRET=replace-with-random-secret
# JWT 过期时间（分钟，默认 1440 = 24 小时）
JWT_EXPIRE_MINUTES=1440
# 允许的 CORS 域名（逗号分隔）
CORS_ORIGINS=http://localhost:80,http://localhost:8000
# API 限流：每分钟请求数
RATE_LIMIT_PER_MINUTE=60

# ---------- 数据库 ----------
# 开发环境默认 SQLite，生产环境请使用 PostgreSQL
# DATABASE_URL=postgresql://user:password@postgres:5432/devops
DATABASE_URL=sqlite:///./devops.db

# ---------- SSH 远程运维 ----------
# SSH 连接超时（秒）
SSH_TIMEOUT=10
# SSH 命令执行超时（秒）
SSH_COMMAND_TIMEOUT=30

# ---------- Kubernetes ----------
# 启用 Kubernetes AI 运维工具（true/false）
KUBERNETES_ENABLED=false
# kubeconfig 路径
KUBECONFIG_PATH=
# kubectl 命令超时（秒）
KUBERNETES_TIMEOUT=10
# 允许滚动重启 Deployment（危险操作，默认关闭）
KUBERNETES_ALLOW_RESTART=false

# ---------- 监控与告警 ----------
# 指标采集间隔（秒，默认 15）
METRICS_COLLECT_INTERVAL=15
# 告警评估间隔（秒，默认 30）
ALERT_EVALUATE_INTERVAL=30

# ---------- 通知渠道（可选） ----------
# 飞书机器人 Webhook URL
FEISHU_WEBHOOK_URL=
# 钉钉机器人 Webhook URL
DINGTALK_WEBHOOK_URL=
# 企业微信机器人 Webhook URL
WECHAT_WEBHOOK_URL=

# ---------- Embedding / RAG ----------
# Embedding 模型（用于知识库向量化，默认使用与 LLM 相同的 API 端点）
EMBEDDING_MODEL=text-embedding-ada-002
# 向量维度（128 为降级方案维度，生产环境 API 返回通常为 1536）
EMBEDDING_DIMENSION=128

# ---------- Prometheus ----------
# Push Gateway 地址（可选）
PROMETHEUS_PUSH_GATEWAY=

# ---------- MCP（项目2 Enterprise DevOps MCP Server，stdio）----------
# 关闭时仅使用项目1内置工具（与 v1.3.0 行为一致）
ENABLE_MCP=false
# 启动 MCP Server 的命令与参数（逗号分隔）
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m,app.server
# 项目2根目录绝对路径（必填，ENABLE_MCP=true 时）
# MCP_SERVER_CWD=d:\代码项目\AI Agent项目\项目2：Enterprise DevOps MCP Server
MCP_SERVER_CWD=
# 连接/调用超时（秒）
MCP_TIMEOUT=30