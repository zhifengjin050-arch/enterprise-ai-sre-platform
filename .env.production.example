# ============================================================
# AI 智能运维助手 — 生产环境配置
# 使用方式: cp .env.production.example .env.production
# 注意: 生产环境必须修改所有密码和密钥！
# ============================================================

# ============================================================
# 一、数据库配置 (Database)
# ============================================================
# PostgreSQL 连接地址（生产环境必须使用 PostgreSQL）
# 格式: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://devops:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/devops_agent
# PostgreSQL 密码 (docker-compose.prod.yml 使用)
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# ============================================================
# 二、安全配置 (Security)
# ============================================================
# JWT 密钥（生产环境必须使用 64 字符以上强随机字符串）
# 生成: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS_LONG
# JWT 过期时间（分钟，建议 480 = 8 小时）
JWT_EXPIRE_MINUTES=480
# 允许的 CORS 域名（生产环境请精确配置）
# 格式: https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=https://your-domain.com
# API 限流（每分钟请求数，建议 120）
RATE_LIMIT_PER_MINUTE=120

# ============================================================
# 三、LLM 配置 (AI / LLM)
# ============================================================
# LLM API 密钥（必填）
DEEPSEEK_API_KEY=sk-your-production-api-key
# API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称
DEEPSEEK_MODEL_NAME=deepseek-chat

# ============================================================
# 四、应用配置 (Application)
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=WARNING
ENVIRONMENT=production

# ============================================================
# 五、SSH 远程运维 (SSH)
# ============================================================
SSH_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30

# ============================================================
# 六、Kubernetes (Kubernetes)
# ============================================================
KUBERNETES_ENABLED=false
KUBECONFIG_PATH=
KUBERNETES_TIMEOUT=10
KUBERNETES_ALLOW_RESTART=false

# ============================================================
# 七、监控配置 (Monitoring)
# ============================================================
METRICS_COLLECT_INTERVAL=15
ALERT_EVALUATE_INTERVAL=30

# ============================================================
# 八、通知渠道 (Notification)
# ============================================================
# 飞书机器人 Webhook URL
FEISHU_WEBHOOK_URL=
# 钉钉机器人 Webhook URL
DINGTALK_WEBHOOK_URL=
# 企业微信机器人 Webhook URL
WECHAT_WEBHOOK_URL=

# ============================================================
# 九、Prometheus (Monitoring)
# ============================================================
PROMETHEUS_PUSH_GATEWAY=

# ============================================================
# 十、Grafana (Visualization)
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD